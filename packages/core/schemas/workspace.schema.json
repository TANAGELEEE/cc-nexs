{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cc-nexs workspace configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repositories"],
  "properties": {
    "version": { "const": 1 },
    "docs_repository": { "type": "string" },
    "worktree_root": { "type": "string", "default": ".worktrees" },
    "allow_external_paths": { "type": "boolean", "default": false },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "path": { "type": "string" },
          "base_branch": { "type": "string", "default": "main" },
          "test_branch": { "type": ["string", "null"] },
          "release_order": { "type": "integer", "minimum": 0, "default": 100 },
          "docs": { "type": "boolean", "default": false },
          "match": { "type": "array", "items": { "type": "string" } },
          "build_cmd": { "type": "string" },
          "test_cmd": { "type": "string" },
          "lint_cmd": { "type": "string" }
        }
      }
    }
  }
}
