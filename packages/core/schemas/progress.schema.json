{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cc-nexs progress.json v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature", "preset", "mode", "state", "revision", "counters", "sprint", "gates", "repositories", "events"],
  "properties": {
    "schema_version": { "const": 2 },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug"],
      "properties": { "id": { "type": "string" }, "slug": { "type": "string" } }
    },
    "preset": { "type": "string" },
    "mode": { "enum": ["lean", "fast", "full", "hotfix", "lite"] },
    "state": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "created_at": { "type": ["string", "null"] },
    "updated_at": { "type": ["string", "null"] },
    "counters": {
      "type": "object",
      "required": ["review_revision", "fix_per_bug", "evaluator_reject"],
      "properties": {
        "review_revision": { "type": "integer", "minimum": 0 },
        "fix_per_bug": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "evaluator_reject": { "type": "integer", "minimum": 0 }
      }
    },
    "sprint": { "type": "object" },
    "hotfix": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["severity", "related_feature", "scope_binding", "scope_bound_at", "review_required"],
      "properties": {
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "related_feature": { "type": ["string", "null"] },
        "scope_binding": {
          "type": "object",
          "required": ["hotfix_scope_sha256", "severity", "related_feature", "file"],
          "properties": {
            "hotfix_scope_sha256": { "type": "string" },
            "severity": { "enum": ["P0", "P1", "P2", "P3"] },
            "related_feature": { "type": ["string", "null"] },
            "file": { "const": "hotfix.md" }
          }
        },
        "scope_bound_at": { "type": "string" },
        "review_required": { "type": "boolean" }
      }
    },
    "gates": { "type": "object" },
    "local_verification": {
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "context": { "enum": [null, "implementation", "review", "test", "gateway_b", "hotfix_fix"] },
        "candidate_fingerprint": { "type": ["string", "null"] },
        "attempts": { "type": "array" }
      }
    },
    "review": { "type": "object" },
    "change_requests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "items"],
      "properties": {
        "current": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "feedback", "affected_acs", "paths", "status", "requested_by", "requested_at"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["evidence", "implementation", "scope"] },
              "feedback": { "type": "string", "minLength": 1 },
              "affected_acs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "status": { "enum": ["recorded", "open", "addressed", "approved"] },
              "requested_by": { "type": "string" },
              "requested_at": { "type": "string" },
              "resolved_at": { "type": "string" }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "description": "Optional only for legacy progress.json compatibility. New v2 progress files include delivery; release mutations inject the safe per_sprint + manual default when it is absent.",
      "additionalProperties": false,
      "required": ["strategy", "test"],
      "properties": {
        "strategy": { "enum": ["final_only", "per_sprint"] },
        "base": { "type": "object" },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "status", "attempts"],
          "properties": {
            "policy": { "enum": ["auto_if_ready", "manual", "disabled"] },
            "status": {
              "enum": ["idle", "running", "deploying", "succeeded", "failed", "deployed_needs_manual_verification", "verified"]
            },
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "round", "fingerprint", "status", "source", "integrations", "started_at"],
                "properties": {
                  "id": { "type": "string" },
                  "round": { "type": "integer", "minimum": 1 },
                  "fingerprint": { "type": "string" },
                  "status": { "type": "string" },
                  "source": { "type": "object" },
                  "integrations": { "type": "object" },
                  "pipeline": { "type": ["object", "null"] },
                  "deployment": { "type": ["object", "null"] },
                  "environment_revision": { "type": ["object", "string", "null"] },
                  "verification": { "type": ["object", "null"] },
                  "started_at": { "type": "string" },
                  "completed_at": { "type": ["string", "null"] },
                  "reason": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "repositories": { "type": "object" },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sequence", "timestamp", "type", "actor"],
        "properties": {
          "id": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "timestamp": { "type": "string" },
          "type": { "type": "string" },
          "actor": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "reason": { "type": "string" },
          "data": { "type": "object" }
        }
      }
    }
  }
}
