{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cc-nexs private preset overlay",
  "description": "Project or organization rules merged over a public preset. Keep this file outside the public cc-nexs repository.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "stack": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "build_cmd": { "type": "string" },
        "test_cmd": { "type": "string" },
        "lint_cmd": { "type": "string" },
        "build_cache": { "type": "boolean" },
        "build_max_parallel": { "type": "integer", "minimum": 1, "maximum": 16 },
        "src_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_patterns": { "type": "array" },
        "custom_review_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "paths": { "type": "object" },
    "workflow": {
      "type": "object",
      "properties": {
        "default_mode": { "enum": ["lean", "hotfix"] },
        "implementation_max_parallel": { "type": "integer", "minimum": 1, "maximum": 16 },
        "local_verify": {
          "type": "object",
          "properties": {
            "driver": { "$ref": "#/definitions/driver" },
            "reuse_passed": { "type": "boolean" },
            "min_free_gb": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "models": { "$ref": "#/definitions/models" },
    "review": {
      "type": "object",
      "description": "Code Review after test verification. policy decides when a Lean task needs one; the panel lists the reviewers. Without a panel, one native reviewer uses the Reviewer role routing.",
      "additionalProperties": false,
      "properties": {
        "policy": { "enum": ["risk", "always"], "default": "risk", "description": "risk: Lean reviews high/critical plans and candidates touching sensitive or required_paths; always: every Lean task. Hotfix always reviews." },
        "required_paths": { "type": "array", "items": { "type": "string" }, "description": "Extra path globs (repository-relative) whose change requires a Review" },
        "panel": {
          "description": "A list for every runtime, or a map of claude/codex/pi lists.",
          "oneOf": [
            { "$ref": "#/properties/review/$defs/reviewers" },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claude": { "$ref": "#/properties/review/$defs/reviewers" },
                "codex": { "$ref": "#/properties/review/$defs/reviewers" },
                "pi": { "$ref": "#/properties/review/$defs/reviewers" }
              }
            }
          ]
        },
        "skills": { "type": "array", "items": { "type": "string" }, "description": "Skill directories or Markdown files every reviewer reads first, relative to the workspace" }
      },
      "$defs": {
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
              "executor": { "enum": ["native", "codex-cli", "claude-cli", "agy-cli", "dsh-cli", "pi-cli"], "default": "native" },
              "profile": { "type": "string", "description": "native only: model profile name" },
              "model": { "type": "string" },
              "effort": { "type": "string" },
              "provider": { "type": "string", "description": "dsh-cli: provider of model" },
              "dsh_profile": { "type": "string", "description": "dsh-cli: dsh profile, default headless" },
              "timeout_seconds": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "test": {
          "type": "object",
          "properties": {
            "environment": { "type": "string" },
            "app_url": { "type": "string" },
            "operations_url": { "type": "string" },
            "allowed_hosts": { "type": "array", "items": { "type": "string" } },
            "credential_ref": { "type": "string" },
            "driver": { "$ref": "#/definitions/driver" },
            "browser": { "type": "object" }
          }
        },
        "base": {
          "type": "object",
          "properties": { "policy": { "enum": ["direct_after_approval", "manual"] }, "driver": { "$ref": "#/definitions/driver" } }
        }
      }
    }
  },
  "definitions": {
    "driver": {
      "type": ["object", "null"],
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "profiles": { "type": "object" },
        "roles": { "type": "object" },
        "routing": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "default_risk_tier": { "enum": ["low", "medium", "high", "critical"] },
            "rules": { "type": "array" }
          }
        }
      }
    }
  }
}
