{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cc-nexs preset.yml",
  "description": "Schema for a cc-nexs preset declaration. Each preset describes which roles are enabled, which tools to use for review, what stack-specific checks to run, and what i18n locale to load.",
  "type": "object",
  "required": ["name", "version", "roles", "stack"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "language": {
      "type": "string",
      "enum": ["zh-CN", "en-US"],
      "default": "en-US"
    },
    "roles": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Role identifiers in execution order. Common: planner, tech-lead, sa, qa, evaluator. Custom roles allowed."
        },
        "definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["agent", "tool"],
            "properties": {
              "agent": { "type": "string", "description": "Path to agent .md file relative to preset root" },
              "tool": {
                "type": "string",
                "enum": ["claude-subagent", "codex", "native-agent", "pi-subagent", "gemini", "openai-cli", "custom"],
                "description": "Which reviewer tool drives this role"
              },
              "alias": { "type": "string", "description": "Display name (e.g. 'PM' instead of 'planner')" },
              "session_isolation": {
                "type": "string",
                "enum": ["independent", "shared"],
                "default": "independent"
              },
              "model": { "type": "string" },
              "model_profile": { "type": "string" }
            }
          }
        }
      }
    },
    "runtimes": {
      "type": "object",
      "properties": {
        "claude": { "$ref": "#/definitions/runtime" },
        "codex": { "$ref": "#/definitions/runtime" },
        "pi": { "$ref": "#/definitions/runtime" }
      }
    },
    "models": { "$ref": "#/definitions/models" },
    "stack": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["java-maven", "node-pnpm", "python-poetry", "rust-cargo", "go-mod", "generic"]
        },
        "build_cmd": { "type": "string" },
        "test_cmd": { "type": "string" },
        "lint_cmd": { "type": "string" },
        "build_cache": { "type": "boolean", "default": true },
        "build_max_parallel": { "type": "integer", "minimum": 1, "maximum": 16, "default": 2 },
        "src_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_patterns": {
          "type": "array",
          "description": "Regex patterns disallowed in source code, with optional excludes for comments/logs",
          "items": {
            "type": "object",
            "required": ["regex"],
            "properties": {
              "regex": { "type": "string" },
              "excludes": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        },
        "custom_review_rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Free-text rules to inject into reviewer prompt"
        }
      }
    },
    "paths": {
      "type": "object",
      "properties": {
        "doc_dir": { "type": "string", "default": "doc/{id}.{slug}/" },
        "doc_repo": { "type": "string", "description": "Documentation repository path relative to the workspace root" },
        "doc_repo_branch": { "type": "string", "description": "Base branch used by the documentation repository" },
        "branch_pattern": { "type": "string", "default": "feature/{id}-{slug}" },
        "bugs_dir": { "type": "string", "default": "bugs/" }
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "default_mode": { "enum": ["lean", "hotfix", "fast", "full"], "default": "lean" },
        "sprint_enabled": { "type": "boolean", "default": true },
        "sprint_delivery": { "enum": ["final_only", "per_sprint"], "default": "final_only" },
        "implementation_max_parallel": { "type": "integer", "minimum": 1, "maximum": 16, "default": 4 },
        "g2_enabled": { "type": "boolean", "default": true },
        "test_release": {
          "type": "object",
          "properties": {
            "policy": { "enum": ["auto_if_ready", "manual", "disabled"] },
            "on_prerequisite_failure": { "enum": ["manual_gate", "stop"] }
          }
        },
        "local_verify": {
          "type": "object",
          "properties": {
            "driver": { "$ref": "#/definitions/driver" },
            "reuse_passed": { "type": "boolean", "default": true }
          }
        },
        "human_gate_after": {
          "type": "string",
          "description": "State after which to insert human approval gate; null disables gate",
          "default": "spec_reviewing_pass"
        },
        "thresholds": {
          "type": "object",
          "properties": {
            "review_revision": { "type": "integer", "default": 3 },
            "fix_per_bug": { "type": "integer", "default": 3 },
            "evaluator_reject": { "type": "integer", "default": 2 }
          }
        }
      }
    },
    "modes": {
      "type": "object",
      "description": "Mode declarations. Each mode picks a state-machine flavor + an enabled-role subset. The orchestrator reads doc/<id>/config.json.mode to decide which mode is active.",
      "additionalProperties": {
        "type": "object",
        "required": ["enabled", "state_machine"],
        "properties": {
          "description": { "type": "string" },
          "enabled": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "state_machine": {
            "type": "string",
            "enum": ["lean", "hotfix", "full", "fast"],
            "description": "State-machine flavor. lean = plan-first low-token flow; full = 5-role sprint SOP; fast = 3-role single-sprint flow."
          },
          "sprint_enabled": { "type": "boolean", "default": true },
          "g2_enabled": { "type": "boolean", "default": true },
          "sprint_delivery": { "enum": ["final_only", "per_sprint"] },
          "thresholds_override": {
            "type": "object",
            "properties": {
              "review_revision": { "type": "integer" },
              "fix_per_bug": { "type": "integer" },
              "evaluator_reject": { "type": "integer" }
            }
          }
        }
      }
    },
    "i18n": {
      "type": "object",
      "properties": {
        "locale_dir": { "type": "string", "default": "i18n/" },
        "conclusion_pass": { "type": "string", "default": "PASS" },
        "conclusion_fail": { "type": "string", "default": "NEEDS_REVISION" },
        "acceptance_pass": { "type": "string", "default": "PASSED" },
        "acceptance_fail": { "type": "string", "default": "FAILED" },
        "test_pass": { "type": "string", "default": "PASSED" },
        "test_fail": { "type": "string", "default": "BLOCKED" }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "test": {
          "type": "object",
          "properties": {
            "environment": { "type": "string" },
            "app_url": { "type": "string" },
            "operations_url": { "type": "string" },
            "allowed_hosts": { "type": "array", "items": { "type": "string" } },
            "credential_ref": { "type": "string" },
            "driver": { "$ref": "#/definitions/driver" },
            "browser": { "type": "object" }
          }
        },
        "base": {
          "type": "object",
          "properties": { "policy": { "enum": ["direct_after_approval", "manual"] } }
        }
      }
    }
  },
  "definitions": {
    "driver": {
      "type": ["object", "null"],
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "claude": { "$ref": "#/definitions/modelSelection" },
              "codex": { "$ref": "#/definitions/modelSelection" },
              "pi": { "$ref": "#/definitions/modelSelection" }
            }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/modelRoleSelection" }
        },
        "routing": { "$ref": "#/definitions/modelRouting" }
      }
    },
    "modelRoleSelection": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "profile": { "type": "string" },
            "claude": { "$ref": "#/definitions/modelSelection" },
            "codex": { "$ref": "#/definitions/modelSelection" },
            "pi": { "$ref": "#/definitions/modelSelection" }
          }
        }
      ]
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "default_risk_tier": { "enum": ["low", "medium", "high", "critical"], "default": "medium" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "roles"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "when": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "modes": { "type": "array", "items": { "enum": ["lean", "hotfix", "fast", "full", "lite"] } },
                  "risk_tiers": { "type": "array", "items": { "enum": ["low", "medium", "high", "critical"] } },
                  "severities": { "type": "array", "items": { "enum": ["P0", "P1", "P2", "P3"] } }
                }
              },
              "roles": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": { "$ref": "#/definitions/modelRoleSelection" }
              }
            }
          }
        }
      }
    },
    "modelSelection": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "model": { "type": "string" },
            "effort": { "enum": ["inherit", "low", "medium", "high", "xhigh", "max", "ultra"] },
            "reasoning_effort": { "enum": ["inherit", "low", "medium", "high", "xhigh", "max", "ultra"] },
            "thinking": { "enum": ["inherit", "low", "medium", "high", "xhigh", "max", "ultra"] },
            "fallback_models": { "type": "array", "items": { "type": "string" } },
            "fallbackModels": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "properties": {
        "model_policy": { "const": "inherit" },
        "force_native_agents": { "type": "boolean" },
        "force_pi_subagents": { "type": "boolean" },
        "session_isolation": { "enum": ["independent", "shared"] },
        "roles": { "type": "object" }
      }
    }
  }
}
