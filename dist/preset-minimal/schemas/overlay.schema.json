{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cc-nexs private preset overlay",
  "description": "Project or organization rules merged over a public preset. Keep this file outside the public cc-nexs repository.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "stack": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "build_cmd": { "type": "string" },
        "test_cmd": { "type": "string" },
        "lint_cmd": { "type": "string" },
        "build_cache": { "type": "boolean" },
        "build_max_parallel": { "type": "integer", "minimum": 1, "maximum": 16 },
        "src_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_patterns": { "type": "array" },
        "custom_review_rules": { "type": "array", "items": { "type": "string" } }
      }
    },
    "paths": { "type": "object" },
    "workflow": {
      "type": "object",
      "properties": {
        "default_mode": { "enum": ["lean", "hotfix", "fast", "full"] },
        "local_verify": {
          "type": "object",
          "properties": {
            "driver": { "$ref": "#/definitions/driver" },
            "reuse_passed": { "type": "boolean" }
          }
        }
      }
    },
    "models": { "$ref": "#/definitions/models" },
    "release": {
      "type": "object",
      "properties": {
        "test": {
          "type": "object",
          "properties": {
            "environment": { "type": "string" },
            "app_url": { "type": "string" },
            "operations_url": { "type": "string" },
            "allowed_hosts": { "type": "array", "items": { "type": "string" } },
            "credential_ref": { "type": "string" },
            "driver": { "$ref": "#/definitions/driver" },
            "browser": { "type": "object" }
          }
        },
        "base": {
          "type": "object",
          "properties": { "policy": { "enum": ["direct_after_approval", "manual"] } }
        }
      }
    }
  },
  "definitions": {
    "driver": {
      "type": ["object", "null"],
      "properties": {
        "command": { "type": "string" },
        "args": { "type": "array", "items": { "type": "string" } },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "models": {
      "type": "object",
      "properties": {
        "profiles": { "type": "object" },
        "roles": { "type": "object" },
        "routing": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "default_risk_tier": { "enum": ["low", "medium", "high", "critical"] },
            "rules": { "type": "array" }
          }
        }
      }
    }
  }
}
